# Copy to .env and fill in locally. NEVER commit .env (it is gitignored).

# Meta Model API (OpenAI-compatible endpoint)
META_MODEL_API_KEY=<YOUR_META_MODEL_API_KEY>
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_TEAM_ID=<YOUR_TEAM_ID>

# Partner inference (optional)
MODAL_TOKEN_ID=<OPTIONAL>
MODAL_TOKEN_SECRET=<OPTIONAL>
BASETEN_API_KEY=<OPTIONAL>

# AWS backbone (orchestration / storage / demo app)
AWS_REGION=<YOUR_AWS_REGION>
AWS_S3_BUCKET=<YOUR_BUCKET_FOR_DOSSIERS>

# App
APP_HOST=0.0.0.0
APP_PORT=8000
