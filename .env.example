# Copy to .env and fill in locally. NEVER commit .env (it is gitignored).

# --- Provider switch ---------------------------------------------------------
# Leave META_MODEL_API_KEY UNSET to run on the dev endpoint (provider=dev).
# SET META_MODEL_API_KEY to switch the whole pipeline to Meta (provider=meta).
# You can also force it explicitly: PROVIDER=dev | meta
# PROVIDER=dev

# Meta Model API (OpenAI-compatible endpoint) — production path
META_MODEL_API_KEY=<YOUR_META_MODEL_API_KEY>
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_TEAM_ID=<YOUR_TEAM_ID>

# Dev stand-in endpoint (this VM) — used only while no Meta key is present.
# On this VM ABACUS_API_KEY is already exported; these have sane defaults in settings.py.
# DEV_API_BASE_URL=https://routellm.abacus.ai/v1
# DEV_API_KEY=<falls back to $ABACUS_API_KEY>
# DEV_MODEL=gpt-5.4-mini

# Partner inference (optional)
MODAL_TOKEN_ID=<OPTIONAL>
MODAL_TOKEN_SECRET=<OPTIONAL>
BASETEN_API_KEY=<OPTIONAL>

# AWS backbone (orchestration / storage / demo app)
AWS_REGION=<YOUR_AWS_REGION>
AWS_S3_BUCKET=<YOUR_BUCKET_FOR_DOSSIERS>

# App
APP_HOST=0.0.0.0
APP_PORT=8000
